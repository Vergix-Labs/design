{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/product/**",
              "ui_kits/copilot/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Spectral|Hanken Grotesk|Spline Sans Mono))/i]",
        "message": "Font not provided by the design system. Available: Spectral, Hanken Grotesk, Spline Sans Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AINote'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|quiet|actions|children|key|ref|className|style|children)$/]",
        "message": "<AINote> doesn't accept that prop. Declared props: label, quiet, actions, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|icon|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, icon, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ai|gate|artifact|positive|negative|neutral|accent)$/]",
        "message": "<Badge> tone must be one of 'ai' | 'gate' | 'artifact' | 'positive' | 'negative' | 'neutral' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|leftIcon|rightIcon|fullWidth|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, leftIcon, rightIcon, fullWidth, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|secondary|ghost|ai|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'secondary' | 'ghost' | 'ai' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|header|elevation|radius|interactive|sunken|padded|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, meta, header, elevation, radius, interactive, sunken, padded, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:flat|raised)$/]",
        "message": "<Card> elevation must be one of 'flat' | 'raised'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Card> radius must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionLogEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:gate|decision|options|who|action|key|ref|className|style|children)$/]",
        "message": "<DecisionLogEntry> doesn't accept that prop. Declared props: gate, decision, options, who, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionLogEntry'] > JSXAttribute[name.name='action'] > Literal[value!=/^(?:confirmou|sobrescreveu)$/]",
        "message": "<DecisionLogEntry> action must be one of 'confirmou' | 'sobrescreveu'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|required|invalid|multiline|rows|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, required, invalid, multiline, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='GateBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:gate|title|description|actions|children|key|ref|className|style|children)$/]",
        "message": "<GateBanner> doesn't accept that prop. Declared props: gate, title, description, actions, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|source|rank|tags|selected|key|ref|className|style|children)$/]",
        "message": "<OptionCard> doesn't accept that prop. Declared props: title, body, source, rank, tags, selected."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionCard'] > JSXAttribute[name.name='source'] > Literal[value!=/^(?:ia|humano)$/]",
        "message": "<OptionCard> source must be one of 'ia' | 'humano'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhaseStepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:phases|current|showGates|showNumbers|key|ref|className|style|children)$/]",
        "message": "<PhaseStepper> doesn't accept that prop. Declared props: phases, current, showGates, showNumbers."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|accent|icon|onRemove|children|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: selected, accent, icon, onRemove, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='MCDACriterion'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|weight|rank|key|ref|className|style|children)$/]",
        "message": "<MCDACriterion> doesn't accept that prop. Declared props: label, weight, rank."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
