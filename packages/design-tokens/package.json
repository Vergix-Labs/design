{
  "name": "@vergix-labs/design-tokens",
  "version": "0.1.0",
  "private": false,
  "description": "Tokens de design da suite Vergix: JSON semantico como fonte, CSS gerado com prefixo --vx-, temas Dia (light) e Noite (dark) e fontes woff2 com licenca.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-tokens.mjs",
    "prepare": "node scripts/build-tokens.mjs",
    "test": "node --test test/build-tokens.test.mjs test/design-system.test.mjs"
  },
  "files": [
    "dist/tokens.css",
    "dist/tokens.json",
    "dist/fonts.css",
    "fonts/**"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  }
}
